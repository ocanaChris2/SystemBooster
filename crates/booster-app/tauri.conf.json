{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SystemBooster",
  "version": "0.1.0",
  "identifier": "com.systembooster.app",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [
      {
        "title": "SystemBooster",
        "width": 1000,
        "height": 640,
        "minWidth": 860,
        "minHeight": 560,
        "resizable": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi"],
    "icon": ["icons/icon.ico"]
  }
}
